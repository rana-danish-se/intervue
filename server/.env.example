# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Client URL (for CORS)
CLIENT_URL=https://your-client-domain.vercel.app

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-server-domain.vercel.app/api/auth/google/callback

# Email
SENDER_EMAIL=noreply@yourdomain.com
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Additional Gemini Keys (per team member)
WAQAR_GEMINI_KEY=your_key_here
USWA_GEMINI_KEY=your_key_here
FATIMA_GEMINI_KEY=your_key_here
